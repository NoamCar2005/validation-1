{
  "mcpServers": {
    "n8n-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "supergateway",
        "--streamableHttp",
        "https://n8n.srv1241655.hstgr.cloud/mcp-server/http",
        "--header",
        "authorization:Bearer ${N8N_API_TOKEN}"
      ]
    },
    "supabase": {
      "command": "sh",
      "args": [
        "-c",
        "set -a && source .env.local && set +a && npx -y @supabase/mcp-server-supabase@latest --project-ref $SUPABASE_PROJECT_REF"
      ]
    }
  }
}